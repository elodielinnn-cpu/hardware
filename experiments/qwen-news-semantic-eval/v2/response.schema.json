{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hardware-intelligence-radar.local/schemas/qwen-news-review-v2.json",
  "title": "Hardware Intelligence Radar semantic extraction V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "articleId",
    "evidenceUnits",
    "productMatches",
    "strategicContexts",
    "claims",
    "technicalAnalysis",
    "evidenceSufficiency",
    "factualSummary",
    "modelAssessment",
    "uncertainties"
  ],
  "properties": {
    "articleId": { "type": "string", "minLength": 1 },
    "evidenceUnits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "origin", "text"],
        "properties": {
          "evidenceId": { "type": "string", "pattern": "^e[1-9][0-9]*$" },
          "origin": { "type": "string", "enum": ["title", "feed_summary", "official_body", "attributed_body"] },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "productMatches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productId", "productRole", "matchType", "relationshipBasis", "impactDimensions", "claimIds", "evidenceIds", "reason", "confidence"],
        "properties": {
          "productId": { "type": "string", "minLength": 1 },
          "productRole": { "type": "string", "enum": ["article_subject", "related_luxshare_product"] },
          "matchType": { "type": "string", "enum": ["direct_subject", "affected_product", "upstream_input", "adjacent_context", "unresolved"] },
          "relationshipBasis": { "type": "string", "enum": ["explicit_article_evidence", "profile_adjacency_only", "unresolved"] },
          "impactDimensions": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["interface", "performance", "design", "cost", "manufacturing", "capacity", "delivery", "demand", "competition", "power", "thermal"] }
          },
          "claimIds": { "$ref": "#/$defs/optionalClaimIds" },
          "evidenceIds": { "$ref": "#/$defs/evidenceIds" },
          "reason": { "type": "string", "minLength": 1 },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    },
    "strategicContexts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contextType", "materiality", "evidenceBasis", "description", "claimIds", "evidenceIds"],
        "properties": {
          "contextType": { "type": "string", "enum": ["important_customer_supply_chain", "major_industry_platform", "other"] },
          "materiality": { "type": "string", "enum": ["major", "material", "limited", "insufficient"] },
          "evidenceBasis": { "type": "string", "enum": ["explicit_event", "inferred", "insufficient"] },
          "description": { "type": "string", "minLength": 1 },
          "claimIds": { "$ref": "#/$defs/claimIds" },
          "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claimId",
          "eventType",
          "subject",
          "object",
          "eventStage",
          "evidenceConfidence",
          "qualifiers",
          "timeline",
          "factStatus",
          "evidenceIds"
        ],
        "properties": {
          "claimId": { "type": "string", "pattern": "^c[1-9][0-9]*$" },
          "eventType": {
            "type": "string",
            "enum": [
              "product_release",
              "commercial_availability",
              "customer_sampling",
              "customer_adoption",
              "order_contract",
              "mass_production",
              "capacity_expansion",
              "manufacturing_milestone",
              "capital_investment",
              "sourcing_change",
              "supply_demand_change",
              "price_change",
              "technology_route_change",
              "system_architecture_change",
              "risk_policy_change",
              "technical_analysis",
              "promotion",
              "other"
            ]
          },
          "subject": { "type": "string", "minLength": 1 },
          "object": { "type": "string" },
          "eventStage": {
            "type": "string",
            "enum": ["occurred", "confirmed_future", "sampling_validation", "industry_forecast", "rumor", "unknown", "not_applicable"]
          },
          "evidenceConfidence": { "type": "string", "enum": ["official", "attributed_report", "rumor", "unknown"] },
          "qualifiers": { "type": "array", "items": { "type": "string" } },
          "timeline": { "type": ["string", "null"] },
          "factStatus": { "type": "string", "enum": ["fact", "formal_plan", "validation", "forecast", "unconfirmed", "unknown", "not_applicable"] },
          "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
        }
      }
    },
    "technicalAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isDeep", "evidenceBasis", "dimensions", "specificImpacts", "evidenceIds"],
      "properties": {
        "isDeep": { "type": "boolean" },
        "evidenceBasis": { "type": "string", "enum": ["explicit_analysis", "inferred", "insufficient"] },
        "dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["bottleneck", "cost", "performance", "manufacturing_difficulty", "yield", "power", "thermal", "competition"] }
        },
        "specificImpacts": { "type": "array", "items": { "type": "string" } },
        "evidenceIds": { "$ref": "#/$defs/optionalEvidenceIds" }
      }
    },
    "evidenceSufficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "gaps"],
      "properties": {
        "status": { "type": "string", "enum": ["sufficient", "partial", "insufficient"] },
        "gaps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "factualSummary": { "type": "string", "minLength": 1 },
    "modelAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relevance", "priority", "modelHomepageRecommendation", "reason"],
      "properties": {
        "relevance": { "type": "string", "enum": ["high", "medium", "low"] },
        "priority": { "type": "string", "enum": ["high", "medium", "low"] },
        "modelHomepageRecommendation": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "uncertainties": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^e[1-9][0-9]*$" }
    },
    "optionalEvidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^e[1-9][0-9]*$" }
    },
    "optionalClaimIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^c[1-9][0-9]*$" }
    },
    "claimIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^c[1-9][0-9]*$" }
    }
  }
}
