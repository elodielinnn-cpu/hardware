{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hardware-intelligence-radar.local/schemas/qwen-news-review-v2-compact.json",
  "title": "Hardware Intelligence Radar compact semantic extraction V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["articleId", "evidence", "products", "contexts", "claims", "technical", "sufficiency"],
  "properties": {
    "articleId": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "quote"],
        "properties": {
          "id": { "type": "string", "pattern": "^e[1-4]$" },
          "quote": { "type": "string", "minLength": 1 }
        }
      }
    },
    "products": {
      "type": "array", "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["productId", "role", "match", "support", "impacts", "claimIndexes", "evidenceIds"],
        "properties": {
          "productId": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["article_subject", "related_luxshare_product"] },
          "match": { "type": "string", "enum": ["direct_subject", "affected_product", "upstream_input", "adjacent_context", "unresolved"] },
          "support": { "type": "string", "enum": ["explicit_impact", "profile_only", "unresolved"] },
          "impacts": {
            "type": "array", "maxItems": 4, "uniqueItems": true,
            "items": { "type": "string", "enum": ["interface", "performance", "design", "cost", "manufacturing", "capacity", "delivery", "demand", "competition", "power", "thermal"] }
          },
          "claimIndexes": { "$ref": "#/$defs/claimIndexes" },
          "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
        }
      }
    },
    "contexts": {
      "type": "array", "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "materiality", "support", "claimIndexes", "evidenceIds"],
        "properties": {
          "type": { "type": "string", "enum": ["important_customer_supply_chain", "major_industry_platform", "other"] },
          "materiality": { "type": "string", "enum": ["major", "material"] },
          "support": { "const": "explicit_event" },
          "claimIndexes": { "$ref": "#/$defs/claimIndexes" },
          "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
        }
      }
    },
    "claims": {
      "type": "array", "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "subject", "object", "stage", "confidence", "qualifiers", "timeline", "evidenceIds"],
        "properties": {
          "type": { "type": "string", "enum": ["product_release", "commercial_availability", "customer_sampling", "customer_adoption", "order_contract", "mass_production", "capacity_expansion", "manufacturing_milestone", "capital_investment", "sourcing_change", "supply_demand_change", "price_change", "technology_route_change", "system_architecture_change", "risk_policy_change", "technical_analysis", "promotion", "other"] },
          "subject": { "type": "string", "minLength": 1 },
          "object": { "type": "string" },
          "stage": { "type": "string", "enum": ["occurred", "confirmed_future", "sampling_validation", "industry_forecast", "rumor", "unknown", "not_applicable"] },
          "confidence": { "type": "string", "enum": ["official", "attributed_report", "rumor", "unknown"] },
          "qualifiers": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1 } },
          "timeline": { "type": ["string", "null"] },
          "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "technical_analysis" } }, "required": ["type"] },
            "then": {
              "properties": {
                "stage": { "const": "not_applicable" },
                "timeline": { "type": "null" }
              }
            }
          }
        ]
      }
    },
    "technical": {
      "type": "object", "additionalProperties": false,
      "required": ["deep", "support", "dimensions", "impacts", "evidenceIds"],
      "properties": {
        "deep": { "type": "boolean" },
        "support": { "type": "string", "enum": ["explicit_analysis", "inferred", "insufficient"] },
        "dimensions": {
          "type": "array", "maxItems": 4, "uniqueItems": true,
          "items": { "type": "string", "enum": ["bottleneck", "cost", "performance", "manufacturing_difficulty", "yield", "power", "thermal", "competition"] }
        },
        "impacts": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1 } },
        "evidenceIds": { "$ref": "#/$defs/optionalEvidenceIds" }
      }
    },
    "sufficiency": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reasonCodes"],
      "properties": {
        "status": { "type": "string", "enum": ["sufficient", "insufficient", "requires_full_text", "unable_to_assess"] },
        "reasonCodes": {
          "type": "array", "maxItems": 4, "uniqueItems": true,
          "items": { "type": "string", "enum": ["source_evidence_insufficient", "requires_full_text", "product_mapping_uncertain", "impact_not_explicit", "event_stage_uncertain", "conflicting_source_evidence", "unable_to_assess", "other"] }
        }
      }
    }
  },
  "$defs": {
    "evidenceIds": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^e[1-4]$" }
    },
    "optionalEvidenceIds": {
      "type": "array", "maxItems": 4, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^e[1-4]$" }
    },
    "claimIndexes": {
      "type": "array", "maxItems": 3, "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0, "maximum": 2 }
    }
  }
}
